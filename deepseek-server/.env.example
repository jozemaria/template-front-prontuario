# Copie este arquivo para .env e preencha com sua chave da API do DeepSeek
# Obtenha a chave em: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-*****
# Modelo usado (deepseek-chat ou deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat
# Porta do servidor proxy
PORT=3000
# Bloqueia mensagens fora do tema (medicina veterinária/animais). true ou false
ENABLE_TOPIC_GUARD=true
